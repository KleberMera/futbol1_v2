Options -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteBase /futbolv2/

# 1. Si el archivo físico existe (ej: .js, .css, .png), se sirve directamente
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Si es un directorio y tiene un index.html (gracias a trailingSlash: true), se sirve
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# 3. Si la ruta no tiene punto (no es un archivo) y no termina en /, redirigir a con /
# Esto ayuda a que trailingSlash de Next.js funcione siempre igual
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.
RewriteRule ^(.*)$ %{REQUEST_URI}/ [L,R=301]

# 4. Fallback para el router de Next.js (SPA)
RewriteRule . index.html [L]
